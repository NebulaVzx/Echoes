# Echoes (拾忆) - Environment Variables Template
# Copy this file to .env and fill in real values
# DO NOT commit .env to Git

# JWT Secret (required) - Generate a strong random string
# e.g., openssl rand -base64 64
JWT_SECRET=

# GitHub OAuth (optional - required for GitHub login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8088/api/v1/auth/github/callback

# CORS Origins (optional)
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
