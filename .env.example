# Echoes (拾忆) - Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to Git

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# Encryption Key for API Key storage (optional - falls back to JWT_SECRET)
# Used to encrypt/decrypt per-user API Keys in the database
ENCRYPTION_KEY=your-encryption-key-here

# Internal API Token for service-to-service communication
# All services (memory-service, processor-service, vectorizer-service) must share this token
INTERNAL_API_TOKEN=dev-internal-token

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# GitHub OAuth (optional - leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8188/api/v1/auth/github/callback

# CORS Origins (optional)
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Observability
GRAFANA_ADMIN_PASSWORD=admin
LOG_LEVEL=info
SERVICE_VERSION=0.2.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
